# ============================================================
# AICameraTestLab 凭据模板
#
# 用法:
#   cp .env.example .env      # 然后填入真实值
#
# 规则:
#   - 真正的 .env 被 .gitignore 排除, 绝不入库
#   - YAML 配置里只写 ${VAR} 占位符, 不写明文
#   - 真实环境变量优先级高于 .env, CI/容器可直接注入, 不必落盘
#   - 取值统一走 envloader:  from envloader import require
# ============================================================

# ---------- 摄像头设备 SSH ----------
# 主用设备 root 口令 (camera.yaml -> ssh_password)
# ⚠️ 这是设备本机 Linux 系统的账号, 与下面的"云平台业务账号"是两套独立体系, 互不相通
CAMERA_SSH_PASSWORD=change-me-camera-root
# X3 备用机口令
X3_SSH_PASSWORD=change-me-x3-root

# ---------- 云平台业务账号 (yuntiyu-test) ----------
# 用途: 登录摄像头网页界面 / 云平台。不能用于 SSH。
YUNTIYU_ACCOUNT_USERNAME=huangpu
YUNTIYU_ACCOUNT_PASSWORD=change-me-platform-account
# 账号密码的 md5, 部分老接口要求传这个字段
YUNTIYU_ACCOUNT_ENCODE_PASSWORD=change-me-md5-of-password
# 摄像头接口鉴权 JWT (设备登录后返回, 与设备绑定)
# 获取: POST http://<设备IP>/camera/login -> 响应 data.authorization
# ⚠️ 与设备一一对应, 换测试设备后必须重新获取
YUNTIYU_X_TOKEN=change-me-camera-x-token
# 平台侧 API token (注意带 "Bearer " 前缀)
YUNTIYU_API_TOKEN="Bearer change-me-platform-api-token"

# 应用签名 secret, 按 appId 索引
YUNTIYU_SECRET_10000=change-me
YUNTIYU_SECRET_10001=change-me
YUNTIYU_SECRET_10002=change-me
YUNTIYU_SECRET_80001=change-me
YUNTIYU_SECRET_100055=change-me

# ---------- 设备授权码 ----------
CAMERA_LICENCE=change-me-device-licence

# ---------- 测试库 MySQL ----------
# 只读测试账号即可, 不要用生产读写账号
UAD_MYSQL_PASSWORD=change-me-mysql-password

# ---------- 本机测试库 (由 SQL/init_db.py 自动写入, 一般无需手改) ----------
# 2026-09-17 起项目自带一个本机测试库 ai_camera_test, 用于"造数/清数"。
# 初始化: E:\TestTools\venv\Scripts\python.exe SQL\init_db.py --root-password <root口令>
LOCAL_MYSQL_HOST=127.0.0.1
LOCAL_MYSQL_PORT=3306
LOCAL_MYSQL_DATABASE=ai_camera_test
LOCAL_MYSQL_USER=aicam_test_rw
# 专用账号口令, 首次初始化时随机生成
AICAM_MYSQL_PASSWORD=change-me-generated-by-init-db
# 本机 MySQL 的 root 口令(仅初始化/运维用, 测试代码不需要)
LOCAL_MYSQL_ROOT_PASSWORD=change-me-local-root

# ---------- 平台运行选项 (可选, 都有合理默认值) ----------
# 统一入口 run.py 用的解释器。留空则自动探测(优先项目 venv)。
# 只有在自动探测失败时才需要显式指定。
# AICAM_PYTHON=E:/TestTools/venv/Scripts/python.exe

# git 可执行文件路径。留空则自动探测。
# AICAM_GIT=D:\Git\cmd\git.EXE

# 批次默认环境名与触发者(写进结果库 test_run 表, 便于区分"谁跑的")
AICAM_ENV=test
# AICAM_TRIGGER_BY=你的名字或CI名称
